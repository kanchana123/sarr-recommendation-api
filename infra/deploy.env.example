# Copy to infra/deploy.env and fill in values (infra/deploy.env is gitignored).
# Used by scripts/setup_gcp_vertex_auth.sh and scripts/deploy_lambda.sh

AWS_REGION=us-east-1
SAM_STACK=sarr-search

# Vertex Gemini (GCP)
GCP_PROJECT_ID=sarr-505305
GCP_SA_NAME=sarr-lambda-vertex
# Secret name Lambda reads (must match infra/template.yaml GCP_CREDENTIALS_SECRET_ARN)
GCP_SECRET_NAME=sarr-search/gcp-vertex
GcpProjectId=sarr-505305

# Qdrant Cloud (required for deploy)
QDRANT_URL=https://YOUR-CLUSTER.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=sarr

# After first `sam deploy --guided`, paste the ECR image repository URI here for
# non-guided redeploys (CloudFormation → ECR repository physical id).
# Example: 123456789012.dkr.ecr.us-east-1.amazonaws.com/sarrsearch…/searchfunction…repo
SAM_IMAGE_REPOSITORY=
