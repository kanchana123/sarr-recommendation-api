# BigQuery
# GCP_PROJECT_ID = your own GCP project (billing/quota only — do NOT create a table)
GCP_PROJECT_ID=your-gcp-project-id
# ETL extract: pypi (default, ~800k+ projects) or libraries_io (legacy ~168k)
ETL_EXTRACT_SOURCE=pypi
BQ_PYPI_PROJECT=bigquery-public-data
BQ_PYPI_DATASET=pypi
BQ_LIBRARIES_PROJECT=bigquery-public-data
BQ_LIBRARIES_DATASET=libraries_io
# Legacy libraries_io-only mode (when ETL_EXTRACT_SOURCE=libraries_io)
BQ_SOURCE_PROJECT=bigquery-public-data
BQ_DATASET=libraries_io
BQ_TABLE=projects
GOOGLE_APPLICATION_CREDENTIALS=
# Lambda only: Secrets Manager secret name/ARN of a GCP service account JSON
# GCP_CREDENTIALS_SECRET_ARN=sarr-search/gcp-vertex
# Provision for Lambda: make gcp-setup-vertex  (see infra/deploy.env.example)
# Optional local override (never commit the JSON)
# GCP_SERVICE_ACCOUNT_JSON=

# Watermark — use 1970-01-01 for initial full load
LAST_UPDATE_DATE=1970-01-01
# Corpus sizing (~500k–700k vectors-only on Qdrant free tier; metadata from BigQuery at search)
ETL_MIN_DESCRIPTION_LENGTH=25
ETL_MIN_LONG_DESCRIPTION_LENGTH=80
ETL_ACTIVE_WITHIN_DAYS=2920
ETL_REQUIRE_ANY_POPULARITY=true
ETL_MIN_STARS=1
ETL_MIN_FORKS=1
ETL_MIN_SOURCE_RANK=4
ETL_MIN_DEPENDENT_PROJECTS=1
ETL_MAX_PACKAGES=700000
QDRANT_VECTORS_ONLY=true
SEARCH_METADATA_OVER_FETCH=3

# Qdrant Cloud (required for search against the indexed corpus)
QDRANT_URL=https://YOUR-CLUSTER.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=sarr

# Embedding / ranking (must match Colab ETL and Lambda)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DIM=384

# Lambda / local API
AWS_REGION=us-east-1
RERANK_ENABLED_DEFAULT=false
SEARCH_TOP_K=50
RERANK_TOP_K=20

# RAG / Vertex AI Gemini (local or Cloud Run; API Gateway does not stream SSE)
RAG_RETRIEVE_K=50
RAG_RERANK_K=50
RAG_CONTEXT_K=10
RAG_LLM_TIMEOUT_S=20
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash-lite
VERTEX_GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Frontend / CLI
VITE_API_BASE_URL=http://localhost:8080
# Optional: default API for `sarr search` / `sarr health` (else localhost:8080)
SARR_API_URL=http://localhost:8080
