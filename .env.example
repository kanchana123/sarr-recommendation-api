# BigQuery
# GCP_PROJECT_ID = your own GCP project (billing/quota only — do NOT create a table)
GCP_PROJECT_ID=your-gcp-project-id
# Libraries.io public source (PyPI projects + repository stars)
BQ_SOURCE_PROJECT=bigquery-public-data
BQ_DATASET=libraries_io
BQ_TABLE=projects
GOOGLE_APPLICATION_CREDENTIALS=

# Watermark — use 1970-01-01 for initial full load
LAST_UPDATE_DATE=1970-01-01

# Qdrant Cloud (required for search against the indexed corpus)
QDRANT_URL=https://YOUR-CLUSTER.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=sarr

# Embedding / ranking (must match Colab ETL and Lambda)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DIM=384

# Lambda / local API
AWS_REGION=us-east-1
RERANK_ENABLED_DEFAULT=false
SEARCH_TOP_K=50
RERANK_TOP_K=20

# RAG / Vertex AI Gemini (local or Cloud Run; API Gateway does not stream SSE)
RAG_RETRIEVE_K=50
RAG_RERANK_K=50
RAG_CONTEXT_K=8
RAG_LLM_TIMEOUT_S=20
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash-lite
VERTEX_GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Frontend / CLI
VITE_API_BASE_URL=http://localhost:8080
# Optional: default API for `sarr search` / `sarr health` (else localhost:8080)
SARR_API_URL=http://localhost:8080
