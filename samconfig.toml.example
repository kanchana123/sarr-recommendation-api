# Copy to samconfig.toml after first deploy (or edit paths/overrides).
# Generated by: sam deploy --guided
# See infra/README.md

version = 0.1

[default.deploy.parameters]
stack_name = "sarr-search"
region = "us-east-1"
confirm_changeset = true
capabilities = "CAPABILITY_IAM"
resolve_s3 = true
disable_rollback = true
image_repositories = ["SearchFunction=YOUR_ACCOUNT.dkr.ecr.us-east-1.amazonaws.com/YOUR_ECR_REPO"]
parameter_overrides = [
  "QdrantUrl=https://YOUR-CLUSTER.us-east-1-1.aws.cloud.qdrant.io",
  "QdrantCollection=sarr",
  "EmbeddingModel=/var/task/models/bge-small-en-v1.5",
  "RerankerModel=/var/task/models/ms-marco-MiniLM-L-6-v2",
  "GcpProjectId=sarr-505305",
]
